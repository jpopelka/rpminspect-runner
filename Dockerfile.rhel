# Tag of the images.paas.redhat.com/osci/base image to build on top of, which
# selects the RHEL major version: "latest" is RHEL 9, "10" is RHEL 10.
ARG BASE_IMAGE_TAG=latest

FROM images.paas.redhat.com/osci/base:${BASE_IMAGE_TAG}
LABEL maintainer "OSCI"
LABEL description="rpminspect for RHEL"

# https://copr.fedorainfracloud.org/coprs/g/osci/rpminspect/
ENV RPMINSPECT_PACKAGE_NAME=rpminspect
# https://copr.devel.redhat.com/coprs/dcantrell/rpminspect-data-redhat/
ENV RPMINSPECT_DATA_PACKAGE_NAME=rpminspect-data-redhat

ENV KOJI_BIN=/usr/bin/brew
ENV RPMINSPECT_CONFIG=/usr/share/rpminspect/redhat.yaml
ENV KOJI_HUB_URL=https://brewhub.engineering.redhat.com/brewhub

# The base image already provides the RH root CA certificates, the nightly RHEL
# repositories, the rcm-tools repository (for the "brew" command), EPEL and jq.
# The RHEL major version (9 or 10) is taken from the base image, so that
# the same Dockerfile works for both.

# Add COPR repositories with
# - rpminspect
# - rpminspect data package
# - latest fedora-license-data
# - latest libabigail
RUN rhel="$(rpm -E %rhel)" && \
    cd /etc/yum.repos.d/ && \
    curl -L -O "https://copr.fedorainfracloud.org/coprs/g/osci/rpminspect/repo/epel-${rhel}/group_osci-rpminspect-epel-${rhel}.repo" && \
    curl -L -O "https://copr.devel.redhat.com/coprs/g/osci/rpminspect-data-redhat/repo/epel-${rhel}/group_osci-rpminspect-data-redhat-epel-${rhel}.repo" && \
    curl -L -O "https://copr.fedorainfracloud.org/coprs/g/osci/fedora-license-data/repo/epel-${rhel}/group_osci-fedora-license-data-epel-${rhel}.repo" && \
    curl -L -O "https://copr.fedorainfracloud.org/coprs/g/osci/libabigail/repo/epel-${rhel}/group_osci-libabigail-epel-${rhel}.repo"

# Update and install dependencies
RUN rhel="$(rpm -E %rhel)" && \
    # On RHEL 9 the rpmautospec macros are a separate package;
    # on RHEL 10 they are shipped by redhat-rpm-config.
    extra_packages="" && \
    if [ "${rhel}" = "9" ]; then extra_packages="rpmautospec-rpm-macros"; fi && \
    dnf -y update && \
    dnf -y install --enablerepo="rhel-${rhel}-buildroot" \
    ${RPMINSPECT_PACKAGE_NAME} \
    ${RPMINSPECT_DATA_PACKAGE_NAME} \
    clamav-update \
    python3-pyyaml \
    python3-click \
    python3-tenacity \
    python3-GitPython \
    koji \
    git \
    brewkoji \
    "libabigail >= 2.8" \
    "annobin-annocheck >= 13.03" \
    redhat-rpm-config \
    ruby-devel \
    rubygems-devel \
    ${extra_packages} \
    && dnf clean all

# Prepare the configuration file to run rpminspect against Brew stage.
RUN cp /usr/share/rpminspect/redhat.yaml /usr/share/rpminspect/redhat-stage.yaml && \
    sed -i 's,brewhub.engineering,brewhub.stage.engineering,g' /usr/share/rpminspect/redhat-stage.yaml && \
    sed -i 's,download.devel.redhat.com,brewweb.stage.engineering.redhat.com,g' /usr/share/rpminspect/redhat-stage.yaml

RUN freshclam

COPY *.sh *.py /usr/local/bin/
